# CAELUM admin console — copy to .env.local and fill in. Never commit real values.

# Origin of the CAELUM API (Render). Give the origin only; /api/v1 is added for you.
# A value ending in /api/v1 also works and is not doubled.
# Required in production builds. Dev builds fall back to http://localhost:5000 when empty.
VITE_API_BASE_URL=https://caelum-api.onrender.com

# Supabase Auth only (sign-in and JWT refresh). The console never reads tables directly.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Show the demo sign-in button (POST /auth/demo-login as admin@caelum.demo).
# Only set to true against a demo API.
VITE_DEMO_MODE=false
