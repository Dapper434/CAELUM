# CAELUM admin console — copy to .env.local (or .env) and adjust. Never commit real secrets.

# Origin of the CAELUM API (Render). Give the origin only; /api/v1 is added for you.
# A value ending in /api/v1 also works and is not doubled.
# Required in production builds. Dev builds fall back to http://localhost:5000 when empty.
VITE_API_BASE_URL=https://caelum-api.onrender.com

# Supabase Auth only (password sign-in and token refresh). The console never reads tables directly.
# The publishable key is public and safe in client code. VITE_SUPABASE_ANON_KEY is still read as a
# fallback for older setups.
VITE_SUPABASE_URL=https://qvqkxuaslayxvjgamtil.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable__zef25WCODbHoGHVOORnhQ_IS5Ue54a

# true shows "Use demo admin" buttons that prefill a demo email (no passwords are embedded).
VITE_DEMO_MODE=false
