# CAELUM backend environment.
# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# The four required keys are SUPABASE_URL, SUPABASE_ANON_KEY,
# OPENROUTER_API_KEY, and NEMOTRON_API_KEY. The rest wire Flask,
# the validation shield, and the on-prem NVIDIA NIM swap.

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL 15 + pgvector)
# Project URL and the anon key the React dashboard uses for realtime reads.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS for onboarding inserts, reservations, and the
# validation shield. Never expose this to the frontend or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Orchestrator — Llama 3.1 8B via OpenRouter (OpenAI-compatible)
# The model may only emit a Pydantic JSON rationale. It must not be asked
# to compute distances, days of cover, or expiry.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ORCHESTRATOR_MODEL=meta-llama/llama-3.1-8b-instruct

# On-prem NVIDIA NIM drop-in. When NIM_BASE_URL is set, the OpenAI client
# uses it instead of OpenRouter. Leave blank during the hackathon demo.
NIM_BASE_URL=
NIM_API_KEY=

# ---------------------------------------------------------------------------
# Policy embeddings — NVIDIA Nemotron 3.5 Embed
# NEMOTRON_EMBED_DIM must stay 1024, matching hospital_policies.embedding
# in backend/supabase/schema.sql (Supabase HNSW indexes cap at 2000 dims).
# Request Matryoshka / truncated output at 1024 from the embed endpoint.
# ---------------------------------------------------------------------------
NEMOTRON_API_KEY=your-nemotron-key
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
NEMOTRON_EMBED_DIM=1024

# ---------------------------------------------------------------------------
# KMHFR onboarding — deterministic HTTP only, no LLM.
# Leave KMHFR_LIVE unset to use the built-in simulated registry via requests.
# Set KMHFR_LIVE=1 to GET {KMHFR_BASE_URL}/facilities/{mfl_code}.
# ---------------------------------------------------------------------------
KMHFR_BASE_URL=https://kmhfl.health.go.ke/api
KMHFR_API_KEY=
KMHFR_LIVE=0

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=*
LOG_LEVEL=INFO
